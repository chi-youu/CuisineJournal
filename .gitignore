# Public root allowlist; local history remains on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE.md
!/MEAL_MASTERY_LICENSE
!/THIRD_PARTY_NOTICES.md
!/CREDITS.txt
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/.github/
!/src/
!/tools/
!/docs/
!/百味纪功能全览.md
!/CONFIGURATION_AND_COMMANDS.md
!/FOOD_INTERACTION_RECIPES.md
!/WORKSTATION_DATAPACK.md
!/INGREDIENT_COMPAT_DATAPACK.md

/tools/*
!/tools/README.md
!/tools/prepare_repository.py
!/tools/test_prepare_repository.py
!/tools/audit_workstation_display.py
!/tools/workstation_display_baseline.json
!/tools/audit_letsdo_hosts.py
!/tools/generate_effect_icons.ps1
!/tools/generate_nutrition_icons.ps1

/docs/*
!/docs/README.md
!/docs/ARCHITECTURE.md
!/docs/BUILDING.md
!/docs/REPOSITORY_PREPARATION.md
!/docs/UNIFICATION.md
!/docs/third-party/

**/build/
**/.gradle/
**/.gradle-user/
**/run/
**/run-data/
**/logs/
**/saves/
**/.idea/
**/.vscode/
**/__pycache__/
**/.cache/
*.pyc
*.log
*.log.gz
*.err
*.tmp
*.bak
.env
.env.*
*.key
*.pem
*.p12
*.jks
*.jar
!/gradle/wrapper/gradle-wrapper.jar
